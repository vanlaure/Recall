# Copy to .env, fill in the keys, then run `npm run check`. Never commit .env.
HOST=127.0.0.1
PORT=3000
# Set a strong token before exposing this single-user application remotely.
APP_TOKEN=

# --- Text (required). Hackathon rule: a runtime Token Factory call to an NVIDIA open model. ---
# Key: https://tokenfactory.nebius.com/ -> API keys.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
# Nemotron IDs in the Token Factory catalog (checked 2026-10-02):
#   nvidia/nemotron-3-super-120b-a12b   balanced, $0.30 / $0.90 per 1M tokens (default)
#   nvidia/Nemotron-3-Ultra-550b-a55b   strongest reasoning, $1 / $3
#   nvidia/Nemotron-3_5-Lightning       fastest and cheapest, $0.06 / $0.24
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Images (optional). Two styles are supported: ---
#   NVIDIA hosted (default): base URL ending in /genai, free key from https://build.nvidia.com (starts nvapi-).
#     Verified 2026-10-02: black-forest-labs/flux.2-klein-4b answers in about 2 s. flux.1-schnell timed out.
#   OpenAI-compatible: any base URL serving /images/generations with response_format=b64_json.
# Token Factory has no image endpoint (/v1/images/generations returned 404 on 2026-10-02).
IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# --- Speech (optional). Any OpenAI-compatible /audio/transcriptions endpoint. Typed input works without it. ---
# Token Factory cannot do this either (/v1/audio/transcriptions returned 404 on 2026-10-02).
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=

# --- Laya (optional). Self-hosted decision model that picks the memory technique before the agents run. ---
# Start it with: docker compose -f compose.laya.yaml up -d --build   (serves http://127.0.0.1:8009, CPU)
# When unset, unreachable, or below LAYA_MIN_CONFIDENCE, the Nemotron Memory Expert picks instead.
LAYA_BASE_URL=
LAYA_API_KEY=
LAYA_MIN_CONFIDENCE=0.4