# Copy to .env, fill in the keys, then run `npm run check`. Never commit .env.
HOST=127.0.0.1
PORT=3000
# Where accounts, kits and images are kept. Defaults to ./data; the Docker image sets /data.
DATA_DIR=
# Accounts: everyone logs in with a username and password, and each account has its own private library
# under data/users/<id>/. Leave SIGNUP_CODE empty for open sign-up, or set it so only people you give the
# code to can create an account (recommended for a public demo, to protect your provider credits).
SIGNUP_CODE=
# Set to 1 only behind a hosting proxy (the Dockerfile does), so login limits use the visitor's address.
TRUST_PROXY=
# Hourly allowances per account. A request that never reached a model, was stopped, or failed at the provider
# gives its slot back.
LIMIT_STORYBOARDS_PER_HOUR=30
LIMIT_IMAGES_PER_HOUR=150
LIMIT_TRANSCRIPTIONS_PER_HOUR=60
LIMIT_REPAIRS_PER_HOUR=30
LIMIT_RESEARCH_PER_HOUR=40
# New accounts per address per hour, and kits one account may keep.
LIMIT_SIGNUPS_PER_HOUR=10
LIMIT_KITS_PER_ACCOUNT=200
# One provider call may take this long before it is reported as timed out (default 60000 ms). PROVIDER_RETRY_MS is
# the pause before a busy provider is retried (default 1500 ms).
PROVIDER_TIMEOUT_MS=
PROVIDER_RETRY_MS=
# Request log on stdout, one JSON line per API request (method, path, status, ms, account id; never a body or key).
# Set to 0 to silence it.
LOG_REQUESTS=
# Set to 0 to stop the studio asking the platform whether the text model is still in its catalogue.
MODEL_CHECK=

# --- Text (required). One switch chooses the platform; both host NVIDIA Nemotron models. ---
#   nebius  Nebius Token Factory. REQUIRED for the hackathon submission and the hosted demo.
#   nvidia  NVIDIA API (build.nvidia.com), free developer key. For development only.
TEXT_PROVIDER=nebius

# Nebius Token Factory. Key: https://tokenfactory.nebius.com/ -> API keys.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
# Nemotron IDs in the Token Factory catalog (checked 2026-10-03):
#   nvidia/nemotron-3-super-120b-a12b   balanced, $0.30 / $0.90 per 1M tokens (default; all measurements were made on it)
#   nvidia/Nemotron-3-Ultra-550b-a55b   strongest reasoning, $1 / $3 (the fallback if Super is retired)
#   nvidia/Nemotron-3_5-Lightning       fastest and cheapest, $0.06 / $0.24
# Platforms retire models: NVIDIA's own API dropped nemotron-3-super on 2026-10-03 with a 410 on every call. The
# studio header warns when the configured model is no longer listed; `npm run check` fails the same way.
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# NVIDIA API. Free key from https://build.nvidia.com (starts nvapi-). Also used for images and speech
# below unless IMAGE_API_KEY / SPEECH_API_KEY are set.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Checked 2026-10-03 on the free tier: nemotron-3-ultra-550b-a55b answered the agent contract in 2.7 s;
# nemotron-3.5-lightning-30b-a3b works but spends about 24 s reasoning; nemotron-3-super-120b-a12b is gone (410).
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Images (optional). Two styles are supported: ---
#   NVIDIA hosted (default): base URL ending in /genai, uses NVIDIA_API_KEY unless IMAGE_API_KEY is set.
#     Verified 2026-10-02: black-forest-labs/flux.2-klein-4b answers in about 2 s. flux.1-schnell timed out.
#   OpenAI-compatible: any base URL serving /images/generations with response_format=b64_json.
# Token Factory has no image endpoint (/v1/images/generations returned 404 on 2026-10-02).
IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Prepended to every image prompt. Leave unset for the built-in ink-illustration style; set to empty for no fixed style.
# IMAGE_STYLE=

# --- Image inspection (optional). A vision model reports what each generated image shows; code applies the rules. ---
# An image with text, numerals, logos, a photographed person, the wrong style or a missing object is regenerated,
# at most three times, then kept and marked for your review. Runs on the text platform unless VISION_PROVIDER
# names the other one. Set a model to empty to switch inspection off.
# Measured 2026-10-02 on 18 labelled checks (docs/EVALUATION.md): GLM-5.3-Flash on Nebius 18/18, about 4 s
# (40 s was seen once on 2026-10-03); Nemotron 3 Nano Omni on NVIDIA 16/18, about 15 s.
VISION_PROVIDER=
NEBIUS_VISION_MODEL=zai-org/GLM-5.3-Flash
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Speech (optional). Typed input works without it. Two styles are supported: ---
#   NVIDIA hosted Riva over gRPC (default): uses NVIDIA_API_KEY unless SPEECH_API_KEY is set, plus the model's function ID.
#     Verified 2026-10-02: parakeet-tdt-0.6b-v2 transcribed a 6 s clip correctly in 0.4 s.
#     Other IDs that worked: parakeet-ctc-1.1b-asr 1598d209-5e27-4d3c-8079-4751568b1081,
#     whisper-large-v3 b702f636-f60c-4a3d-a6f4-f3568c13bd7d, canary-1b-asr b0e8b4a5-217c-40b7-9b96-17d84e666317.
#   OpenAI-compatible: any https base URL serving /audio/transcriptions (SPEECH_FUNCTION_ID unused).
# Token Factory has no speech endpoint (/v1/audio/transcriptions returned 404 on 2026-10-02).
SPEECH_BASE_URL=https://grpc.nvcf.nvidia.com:443
SPEECH_API_KEY=
SPEECH_MODEL=nvidia/parakeet-tdt-0.6b-v2
SPEECH_FUNCTION_ID=d3fe9151-442b-4204-a70d-5fcc597fd610

# --- Research sources (optional overrides, for tests or a mirror). ---
# Tavily web search for the Research Agent (https://tavily.com, key starts with tvly-). Tavily finds which Wikiquote
# page holds a quotation and which chapter and verse a described passage is; the wording is always read from the
# source itself. Optional: without it, Wikiquote's own search and the reference parser are used.
TAVILY_API_KEY=
WIKIQUOTE_BASE_URL=
BIBLE_BASE_URL=

# --- Laya (optional). Self-hosted decision model that answers typed questions about the material. ---
# Start it with: docker compose -f compose.laya.yaml up -d --build   (serves http://127.0.0.1:8009, CPU)
# Code decides what it can determine exactly (digits, counts, labels, the learner's own choice). Laya's answer is
# used only at or above LAYA_MIN_CONFIDENCE and never against those facts; otherwise the Nemotron Memory Expert
# chooses. `npm run eval` measures this on labelled tasks (docs/EVALUATION.md).
LAYA_BASE_URL=
LAYA_API_KEY=
LAYA_MIN_CONFIDENCE=0.5
# Authority per kind of decision: `enforced` (Laya's answer decides, within the code facts) or `advisory` (recorded
# and shown only). Change one only when `npm run eval` supports it for the checkpoint being served.
LAYA_TECHNIQUE_MODE=enforced
LAYA_CUE_MODE=advisory
LAYA_REPAIR_MODE=advisory
